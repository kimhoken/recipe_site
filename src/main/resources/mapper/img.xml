<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.recipe.dao.ImgDAO">

    <insert id="img_insert" parameterType="img"
            useGeneratedKeys="true" keyProperty="img_id">
        insert into image (image_list, target_id, target_type
        ) values ( #{image_list}, #{target_id}, #{target_type} )
    </insert>

    <select id="img_select" parameterType="int" resultType="img">
        select * from image
            where image_id = #{img_id}
    </select>

    <select id="img_select_inquiry" parameterType="int" resultType="img">
        select * from image
        where target_id = #{inquiry_id} 
            and target_type = "INQUIRY"
        order by image_id asc
    </select>

    <insert id="img_insert_review" parameterType="img"
            useGeneratedKeys="true" keyProperty="img_id">
        insert into image (image_list, target_id)
        values ( #{image_list}, #{review_id} )
    </insert>            

    <delete id="img_delete">
        delete from image
        where review_id = #{review_id}
    </delete>

    <update id="img_update" parameterType="img" >
        update image set  image_list = #{image_list}
        where image_id = #{image_id}
    </update>

</mapper>
