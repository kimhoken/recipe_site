<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.recipe.dao.CommunityDAO">

    <select id="CheckList"
            resultType="community">
        select * 
        from community        
    </select>

    <select id="noticeList"
            resultType="community">
        select *
        from community    
        where community_type = "NOTICE"
    </select>

    <insert id="communityInsert"
            useGeneratedKeys="true"
            keyProperty="community_id">
        insert into community (
            member_id, community_type, recipe_id, title, content
        ) values (#{member_id}, #{community_type}, NULLIF(#{recipe_id},0), #{title}, #{content})

    </insert>

    <select id="communitySelect"
            resultType="community">
        select *
        from community
        where community_id = #{community_id}    
    </select>

    <update id="communityUpdate"
            parameterType="community">
        update community
        set title = #{title}, content = #{content}, community_type = #{community_type}
        where community_id = #{community_id} 
            and member_id = #{member_id}

    </update>

    <delete id="communityDelete">
        delete from community
        where community_id = #{community_id}
    </delete>

</mapper>
